@component-name = "portal-solutions"
definition {

	property osgi.modules.includes = "site-initializer-testray";
	property portal.release = "false";
	property portal.upstream = "true";
	property release.feature.flags.disable.DISABLE_PRIVATE_LAYOUTS = "true";
	property testray.main.component.name = "Site Initializer Testray";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Testray.createTestraySite(siteName = "Testray 2");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		Testray.tearDownCP();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
	}

	@description = "This is a test for LPS-156438 - Verify if as an Administrator can Add a Build"
	@ignore = "Test Stub"
	@priority = "5"
	test AdminCanAddBuild {

		task ("Go to Testray") {
			ApplicationsMenu.gotoSite(site = "Testray 2");
		}

		task ("Setup Add project") {
			Testray.gotoAddProject();

			Testray.typeProjectsField(
				projectName = "Builds_1 Project",
				description = "Builds_1 Description");

			Testray.goToProjectPage(projectName = "Builds_1 Project");

			Testray.gotoAddProject();

			TestrayRoutines.typeRoutineField(key_name = "Build_1 Routine");
		}

		task ("Go to Home Page and Change Items Per Page") {
			TestrayLayout.clickResultsOnSidebar();

			Testray.changePaginationInModal(valuePagination = "150");
		}

		task ("Go to Project") {
			Testray.goToProjectPage(projectName = "Liferay Portal 7.4");
		}

		task ("Go to Routines") {
			TestrayRoutines.goToRoutine(routineName = "EE Package Tester");
		}

		task ("Add Build") {
			Testray.gotoAddProject();

			TestrayBuild.typeBuildField(
			fieldName = "Builds_1 Build",
			routine = "EE Package Tester",
			productVersion = "7.4.x",
			gitHash = "12345",
			Description = "Builds_1 Build Description");
		}

		task ("assert if it was created the Build") {
			Testray.assertProjectName(key_name = "Builds_1 Build");
		}

		task ("Go to Build") {
			Testray.goToProjectPage(projectName = "Builds_1 Build");
		}

		task ("assert if it was created the Build with details") {
			TestrayBuild.viewBuildDetails(
			productVersion = "7.4.x",
			Description = "Builds_1 Build Description",
			gitHash = "12345");
		}

	}

