	@description = "This is a test for LPS-156543 - Verify if as an Administrator I am able to edit Builds"
	@ignore = "Test Stub"
	@priority = "5"
	test AdminCanEditBuild {

		task ("Go to Testray") {
			ApplicationsMenu.gotoSite(site = "Testray 2");
		}

		task ("Setup Add Build") {
			Testray.gotoAddProject();

			Testray.typeProjectsField(
				projectName = "Builds_4 Project",
				description = "Builds_4 Description");

			Testray.changePaginationInModal(valuePagination = "150");

			Testray.goToProjectPage(projectName = "Builds_4 Project");

			Testray.gotoAddProject();

			TestrayRoutines.typeRoutineField(key_name = "Build_4 Routine");

			TestrayRoutines.goToRoutine(routineName = "Build_4 Routine");

			Testray.gotoAddProject();

			TestrayBuild.typeBuildField(
				fieldName = "Builds_3 Build",
				routine = "Builds_3 Routine",
				productVersion = "1.x",
				gitHash = "12345",
				Description = "Builds_3 Build Description");

			Testray.assertProjectName(key_name = "Builds_3 Build");
		}

		task ("Go to Home Page and Change Items Per Page") {
			TestrayLayout.clickResultsOnSidebar();

			Testray.changePaginationInModal(valuePagination = "150");
		}

		task ("Go to Project") {
			Testray.goToProjectPage(projectName = "Liferay Portal 7.4");
		}

		task ("Go to Routines") {
			TestrayRoutines.goToRoutine(routineName = "EE Package Tester");
		}

		task ("Add Build") {
			Testray.gotoAddProject();

			TestrayBuild.typeBuildField(
				fieldName = "Builds_4 Build",
				routine = "EE Package Tester",
				productVersion = "7.4.x",
				gitHash = "12345",
				Description = "Builds_4 Build Description");
		}

		task ("Edit Build and asserts that it has been edited") {
			TestrayBuild.editBuild(
				valueName = "Builds_4 Build",
				fieldName = "Build_4 Build Edited",
				routine = "EE Package Tester",
				productVersion = "7.4.x",
				gitHash = "12345",
				Description = "Builds_4 Build Description Edited");

			TestrayManage.assertName(name = "Build_4 Build Edited");
		}

	}

