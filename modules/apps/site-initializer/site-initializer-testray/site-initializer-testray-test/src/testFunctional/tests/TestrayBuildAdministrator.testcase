	@description = "This is a test for LPS-156513 - Verify if as an Administrator I can delete Builds"
	@ignore = "Test Stub"
	@priority = "5"
	test AdminCanDeleteBuild {

		task ("Go to Testray") {
			ApplicationsMenu.gotoSite(site = "Testray 2");
		}

		task ("Setup Add Build") {
			Testray.gotoAddProject();

			Testray.typeProjectsField(
				projectName = "Builds_3 Project",
				description = "Builds_3 Description");

			Testray.changePaginationInModal();

			Testray.goToProjectPage(projectName = "Builds_3 Project");

			Testray.gotoAddProject();

			TestrayRoutines.typeRoutineField(key_name = "Build_3 Routine");

			TestrayRoutines.goToRoutine(routineName = "Build_3 Routine");

			Testray.gotoAddProject();

			TestrayBuild.typeBuildField(
			fieldName = "Builds_3 Build",
			routine = "Builds_3 Routine",
			productVersion = "1.x",
			gitHash = "12345",
			Description = "Builds_3 Build Description");

			Testray.assertProjectName(key_name = "Builds_3 Build");
		}

		task ("Go to Home Page and Change Items Per Page") {
			TestrayLayout.clickResultsOnSidebar();

			Testray.changePaginationInModal(valuePagination = "150");
		}

		task ("Go to Project") {
			Testray.goToProjectPage(projectName = "Liferay Portal 7.4");
		}

		task ("Go to Routines") {
			TestrayRoutines.goToRoutine(routineName = "EE Package Tester");
		}

		task ("Add Build") {
			Testray.gotoAddProject();

			TestrayBuild.typeBuildField(
			fieldName = "Builds_3 Build",
			routine = "EE Package Tester",
			productVersion = "7.4.x",
			gitHash = "12345",
			Description = "Builds_3 Build Description");
		}

		task ("Delete new case type and asserts that it has been deleted") {
			TestrayManage.deleteProject(valueName = "Builds_3 Build");

			TestrayManage.assertNameNotPresent(name = "Builds_3 Build");
		}

	}

