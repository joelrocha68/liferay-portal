definition {

	macro addCases {
		Click(locator1 = "Testray#ADD_PROJECT");

		Type(
			locator1 = "TestrayManage#NEW_OPTION_NAME",
			value1 = "${caseName}");

        Select(
			locator1 = "TestrayCases#CASE_PRIORITY",
			value1 = "${Priority}");

        Select(
			locator1 = "TestrayCases#CASE_TYPE",
			value1 = "${CaseTypeId}");

        Select(
			locator1 = "TestrayCases#MAIN_COMPONENT",
			value1 = "${ComponentId}");

        Type(
			locator1 = "TestrayCases#ESTIMATED_DURATION",
			value1 = "${Duration}");

        Type(
			locator1 = "TestrayCases#FIELD_DESCRIPTION",
			value1 = "${Description}");

        Type(
			locator1 = "TestrayCases#FIELD_STEPS",
			value1 = "${Steps}");

		Click(locator1 = "TestrayManage#SAVE_BUTTON");

        Refresh();
	}

    macro assertCaseDetails {
		AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value1 = "${caseName}");

        AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value2 = "${Priority}");

        AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value3 = "${MainComponent}");

        AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value4 = "${Duration}");

        AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value5 = "${Description}");

        AssertElementPresent(
			locator1 = "TestrayCases#CASE_DETAILS",
			value6 = "${Steps}");

       
	}

}